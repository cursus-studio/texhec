#!/usr/bin/env python3
import os
import sys
import platform
import subprocess
from pathlib import Path

def main():
    repo_root = Path.cwd().resolve()
    cache_dir = repo_root / ".cache"
    cache_dir.mkdir(parents=True, exist_ok=True)

    is_windows = platform.system() == "Windows" or sys.platform == "win32"

    env = os.environ.copy()
    if is_windows:
        env["MSYS_NO_PATHCONV"] = "1"
        env["DOCKER_BUILDKIT"] = "1"

    print("Building docker container...")
    build_cmd = ["docker", "build", "-t", "ci-runner", "cicd"]
    result = subprocess.run(build_cmd, env=env)
    if result.returncode != 0:
        sys.exit(result.returncode)

    docker_cmd = [
        "docker", "run", "--rm",
        "-e", "GOCACHE=/cache/go-cache",
        "-e", "GOPATH=/cache/go-path",
        "-e", "GOLANGCI_LINT_CACHE=/cache/golangci-lint",
    ]

    if is_windows:
        # Windows: use bind propagation and normalize paths
        docker_cmd.extend([
            "-v", f"{cache_dir}:/cache:Z",
            "-v", f"{repo_root}:/app:Z",
        ])
    else:
        # Unix: use standard mounting with user permissions
        docker_cmd.extend([
            "-v", f"{cache_dir}:/cache",
            "-v", f"{repo_root}:/app",
        ])
        if hasattr(os, "getuid"):
            docker_cmd.extend(["-u", f"{os.getuid()}:{os.getgid()}"])

    docker_cmd.extend([
        "-w", "/app",
        "ci-runner", "go", "run", "cicd", "fix"
    ])

    print("Running CI/CD fix...")
    result = subprocess.run(docker_cmd, env=env)
    sys.exit(result.returncode)

if __name__ == "__main__":
    main()
