#!/usr/bin/env python3
import os
import sys
import platform
import subprocess
from pathlib import Path

def main():
    repo_root = Path.cwd().resolve()
    cache_dir = repo_root / ".cache"
    cache_dir.mkdir(parents=True, exist_ok=True)

    is_windows = platform.system() == "Windows" or sys.platform == "win32"

    env = os.environ.copy()
    if is_windows:
        env["MSYS_NO_PATHCONV"] = "1"

    print("Building docker container...")
    build_cmd = ["docker", "build", "-t", "ci-runner", "cicd"]
    result = subprocess.run(build_cmd, env=env)
    if result.returncode != 0:
        sys.exit(result.returncode)

    docker_cmd = [
        "docker", "run", "--rm",
        "-e", "GOCACHE=/cache/go-cache",
        "-e", "GOPATH=/cache/go-path",
        "-e", "GOLANGCI_LINT_CACHE=/cache/golangci-lint",
        "-v", f"{cache_dir}:/cache",
        "-v", f"{repo_root}:/app",
        "-w", "/app",
    ]

    if not is_windows and hasattr(os, "getuid"):
        docker_cmd.extend(["-u", f"{os.getuid()}:{os.getgid()}"])

    docker_cmd.extend(["ci-runner", "go", "run", "cicd", "fix"])

    print("Running CI/CD fix...")
    result = subprocess.run(docker_cmd, env=env)
    sys.exit(result.returncode)

if __name__ == "__main__":
    main()
