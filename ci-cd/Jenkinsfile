pipeline {
    agent {
        dockerfile {
            filename 'Dockerfile'
            dir 'ci-cd'
            args '-v /home/jenkins/go-cache:/root/.cache/go-build -v /home/jenkins/golangci-lint:/root/.cache/golangci-lint'
            // Necessary for OpenGL/Graphics testing if running on a headful agent
            additionalBuildArgs  '--build-arg CACHE_DATE=$(date +%Y-%m-%d)'
        }
    }
    triggers {
        githubPush()
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '20'))
        preserveStashes(buildCount: 5)
    }
    environment {
        CONTEXT = 'jenkins/ci-cd'

        OWNER = 'cursus-studio'
        REPO = 'texhec'
    }

    stages {
        stage('Setup') {
            steps {
                updateGitHubStatus('pending', 'Started...')
                checkout scm
                sh 'go version'
                sh 'golangci-lint --version'
            }
        }
        stage('Deps') {
            steps { runModuleStep('Deps', 'go mod download && go mod tidy -diff && go mod verify') }
        }
        stage('Build') {
            steps { runModuleStep('Build', 'go build -o /dev/null') }
        }
        stage('Security') {
            steps { runModuleStep('Security', 'gosec -quiet ./...') }
        }
        stage('Pipeline Security') {
            steps {
                updateGitHubStatus('pending', 'Pipeline Security')
                sh 'trivy config --exit-code 1 --quiet --severity HIGH,CRITICAL .'
            }
        }
        stage('Lint') {
            steps { runModuleStep('Lint', 'golangci-lint run', false) }
        }
        stage('Test') {
            steps { runModuleStep('Test', 'go test ./...') }
        }
    }
    post {
        success {
            updateGitHubStatus('success', 'Success!')
        }
        failure {
            node('') {
                updateGitHubStatus('failure', "Build failed at stage: \"${env.LAST_STATUS_DESC}\"")
            }
        }
    }
}

def runModuleStep(String statusMsg, String command, boolean isParallel = true) {
    script {
        def modules = ['engine', 'core']

        updateGitHubStatus('pending', "${statusMsg}...")
        def tasks = [:]

        modules.each { mod ->
            tasks[mod] = {
                dir(mod) {
                    sh command
                }
            }
        }
        if (isParallel) {
            tasks.failFast = true
            parallel tasks
        } else {
            tasks.each { name, task ->
                echo "Running task for module: ${name}"
                task()
            }
        }
    }
}

def updateGitHubStatus(String state, String desc) {
    env.LAST_STATUS_DESC = desc
    withCredentials([usernamePassword(credentialsId: 'texhec-app', passwordVariable: 'TOKEN', usernameVariable: 'USER')]) {
        sh """
            curl -L \
                -X POST \
                -H "Accept: application/vnd.github+json" \
                -H "Authorization: Bearer ${TOKEN}" \
                -H "X-GitHub-Api-Version: 2026-03-10" \
                https://api.github.com/repos/${env.OWNER}/${env.REPO}/statuses/${env.GIT_COMMIT} \
                -d '{"state":"${state}","target_url":"${env.BUILD_URL}","description":"${desc}","context":"${env.CONTEXT}"}'
        """
    }
}
