pipeline {
    agent {
        dockerfile {
            filename 'Dockerfile'
            dir 'ci-cd'
            args '-v /home/jenkins/go-cache:/root/.cache/go-build -v /home/jenkins/golangci-lint:/root/.cache/golangci-lint'
            // Necessary for OpenGL/Graphics testing if running on a headful agent
            additionalBuildArgs  '--build-arg CACHE_VERSION=1.0.0'
        }
    }
    triggers {
        githubPush()
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '20'))
        preserveStashes(buildCount: 5)
    }
    environment {
        CONTEXT = 'jenkins/ci-cd'

        OWNER = 'cursus-studio'
        REPO = 'texhec'
    }

    stages {
        stage('Setup') {
            steps {
                updateGitHubStatus('pending', 'Started...')
                checkout scm
                script {
                    if (shouldSkipBuild()) {
                        echo 'Commit message matches skip criteria. Stopping pipeline execution early.'
                        currentBuild.result = 'SUCCESS'
                        env.SKIP_REMAINING_STAGES = 'true'
                        return
                    } else {
                        env.SKIP_REMAINING_STAGES = 'false'
                    }
                }
                sh 'go version'
                sh 'golangci-lint --version'
            }
        }
        // verification {
        stage('Deps') {
            when { environment name: 'SKIP_REMAINING_STAGES', value: 'false' }
            steps { runModuleStep('Deps', 'go mod download && go mod tidy -diff && go mod verify') }
        }
        stage('Build') {
            when { environment name: 'SKIP_REMAINING_STAGES', value: 'false' }
            steps { runModuleStep('Build', 'go build -o /dev/null') }
        }
        stage('Security') {
            when { environment name: 'SKIP_REMAINING_STAGES', value: 'false' }
            steps { runModuleStep('Security', 'gosec -quiet ./...') }
        }
        stage('Pipeline Security') {
            when { environment name: 'SKIP_REMAINING_STAGES', value: 'false' }
            steps {
                updateGitHubStatus('pending', 'Pipeline Security')
                sh 'trivy config --exit-code 1 --quiet --severity HIGH,CRITICAL .'
            }
        }
        stage('Lint') {
            when { environment name: 'SKIP_REMAINING_STAGES', value: 'false' }
            steps { runModuleStep('Lint', 'golangci-lint run', false) }
        }
        stage('Markdown Lint') {
            when { environment name: 'SKIP_REMAINING_STAGES', value: 'false' }
            steps { runGeneralStep('Markdown Lint', 'lychee --root-dir . "**/*.md"') }
        }
        stage('Test') {
            when { environment name: 'SKIP_REMAINING_STAGES', value: 'false' }
            steps { runModuleStep('Test', 'go test ./... -benchtime=1x') }
        }
        // } verification
        // generation {
        stage('Generate Docs') {
            when { environment name: 'SKIP_REMAINING_STAGES', value: 'false' }
            steps { runGeneralStep('Generate Docs', 'go run readme diff') }
        }
        // } generation
        // generation verification {
        stage('Generated Markdown Lint') {
            when { environment name: 'SKIP_REMAINING_STAGES', value: 'false' }
            steps { runGeneralStep('Generated Markdown Lint', 'lychee --root-dir . "**/*.md"') }
        }
        // } generation verification
    }
    post {
        success {
            commitChanges()
            updateGitHubStatus('success', 'Success!')
        }
        failure {
            script {
                if (currentBuild.result == 'SUCCESS') {
                    updateGitHubStatus('success', 'Skipped via commit name.')
                } else {
                    updateGitHubStatus('failure', "Build failed at stage: \\\"${env.LAST_STATUS_DESC}\\\"")
                }
            }
        }
        aborted {
            updateGitHubStatus('error', 'Build was aborted.')
        }
    }
}

def shouldSkipBuild() {
    def commitMsg = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()
    return commitMsg.contains('[skip ci]')
}

def runModuleStep(String statusMsg, String command, boolean isParallel = true) {
    script {
        updateGitHubStatus('pending', "${statusMsg}...")

        def modules = ['engine', 'core', 'readme']
        def tasks = [:]

        modules.each { mod ->
            tasks[mod] = {
                dir(mod) {
                    sh command
                }
            }
        }
        if (isParallel) {
            tasks.failFast = true
            parallel tasks
        } else {
            tasks.each { name, task ->
                echo "Running task for module: ${name}"
                task()
            }
        }
    }
}

def runGeneralStep(String statusMsg, String command, boolean isParallel = true) {
    script {
        updateGitHubStatus('pending', "${statusMsg}...")
        sh command
    }
}

def commitChanges() {
    sh 'git config --global user.email "jenkins@cursus-studio.com"'
    sh 'git config --global user.name "Jenkins CI"'

    def hasChanges = sh(script: 'git status --porcelain', returnStdout: true).trim()

    if (!hasChanges) {
        echo 'No changes detected. Skipping commit.'
        return
    }
    echo 'Changes detected. Committing and pushing...'

    withCredentials([usernamePassword(credentialsId: 'texhec-app', passwordVariable: 'TOKEN', usernameVariable: 'USER')]) {
        sh '''
            git add .
            git commit -m "[skip ci] Automatic update from Jenkins"

            git remote set-url origin https://${USER}:${TOKEN}@github.com/${OWNER}/${REPO}.git

            git push origin HEAD:${GIT_BRANCH}
        '''
    }
}

def updateGitHubStatus(String state, String desc) {
    env.LAST_STATUS_DESC = desc
    withCredentials([usernamePassword(credentialsId: 'texhec-app', passwordVariable: 'TOKEN', usernameVariable: 'USER')]) {
        sh """
            curl -L \
                -X POST \
                -H "Accept: application/vnd.github+json" \
                -H "Authorization: Bearer \$TOKEN" \
                -H "X-GitHub-Api-Version: 2026-03-10" \
                https://api.github.com/repos/${env.OWNER}/${env.REPO}/statuses/${env.GIT_COMMIT} \
                -d '{"state":"${state}","target_url":"${env.BUILD_URL}","description":"${desc}","context":"${env.CONTEXT}"}'
        """
    }
}
